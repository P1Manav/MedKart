{
  "name": "isocode_assignment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "tsx prisma/seed-reset.ts",
    "typecheck": "tsc --noEmit",
    "digest": "node scripts/repo-digest.mjs",
    "digest:fast": "node scripts/repo-digest.mjs --fast"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
