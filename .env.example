# ==============================================================================
# MEDKART ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. CORE ---
# PostgreSQL connection string (Neon serverless or local PostgreSQL via Docker Compose) # required in production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medkart?sslmode=disable"
# Canonical public URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shared secret bearer token securing automated cron routes (/api/cron/reminders) # required in production
CRON_SECRET="dev-cron-secret-change-in-production-min16chars"
# When "true", restricts unauthenticated catalogue requests (/api/products) to OTC items only
PUBLIC_CATALOGUE_OTC_ONLY="false"

# --- 2. SESSION / CRYPTO ---
# Secret key for signing HS256 session JWT cookies (minimum 32 characters) # required in production
SESSION_SECRET="dev-session-secret-change-in-production-must-be-at-least-32-chars-long"
# 64-character hex key (32 bytes) for AES-256-GCM prescription image encryption # required in production
PRESCRIPTION_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Secret pepper for salted HMAC-SHA256 OTP hashing and phone audit logs (min 16 chars) # required in production
OTP_PEPPER="dev-otp-pepper-change-in-production-min16chars"

# --- 3. OTP / SMS ---
# Selected SMS provider: msg91, twilio_verify, fast2sms, or mock
SMS_PROVIDER="mock"
# MSG91 API auth key for SMS dispatch
MSG91_AUTH_KEY=""
# MSG91 DLT approved flow template ID
MSG91_TEMPLATE_ID=""
# Generic SMS provider template ID fallback
SMS_PROVIDER_TEMPLATE_ID=""
# Twilio Account SID for Twilio Verify API
TWILIO_ACCOUNT_SID=""
# Twilio Auth Token
TWILIO_AUTH_TOKEN=""
# Twilio Verify Service SID (starts with VA...)
TWILIO_VERIFY_SERVICE_SID=""
# Fast2SMS API authorization key
FAST2SMS_API_KEY=""

# --- 4. EMAIL ---
# Transactional email provider: resend, brevo, or smtp
EMAIL_PROVIDER="resend"
# Resend API key for email OTP delivery fallback
RESEND_API_KEY=""
# Brevo API key for transactional email delivery
BREVO_API_KEY=""
# SMTP host address for transactional emails
SMTP_HOST=""
# Sender email address for OTP delivery
EMAIL_FROM="noreply@medkart.example.com"

# --- 5. DEMO ---
# Set to "true" for local review (enables top role switcher and mock OTP for demo numbers)
DEMO_MODE="true"
# Comma-separated 10-digit demo phone allowlist (defaults to seeded demo accounts when DEMO_MODE=true)
DEMO_PHONES="9830011111,9830022222,9830033333,9830044444,9830066661,9830099999"

# --- 6. AI / OCR ---
# OCR reader selection: hf, tesseract, or mock (defaults to hf with tesseract WASM fallback)
AI_READER="hf"
# Hugging Face user access token for Tier 1 TrOCR inference API (router.huggingface.co)
HF_API_TOKEN=""
# Hugging Face model identifier
HF_OCR_MODEL="microsoft/trocr-base-handwritten"

# --- 7. PAYMENTS ---
# Razorpay / Cashfree Sandbox Key ID (falls back to simulated sandbox modal if omitted)
PAYMENT_GATEWAY_KEY_ID=""
# Payment Gateway Sandbox Key Secret
PAYMENT_GATEWAY_KEY_SECRET=""
# Webhook secret for HMAC-SHA256 signature verification on /api/payments/webhook
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# --- 8. UPI ---
# Payee VPA for Path B Direct UPI transfer (when omitted, Direct UPI option is hidden)
UPI_PAYEE_VPA=""
# Payee business name displayed in UPI apps
UPI_PAYEE_NAME="MedKart Pharmacy"
# Maximum order amount in INR permitted for Direct UPI transfer (defaults to 100)
UPI_MAX_AMOUNT_INR="100"
