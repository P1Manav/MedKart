# Database connection (PostgreSQL - Neon free tier or local Docker Compose)
DATABASE_URL=""

# Authentication & Session
SESSION_SECRET=""

# Prescription encryption (32-byte hex string for AES-256-GCM)
PRESCRIPTION_ENC_KEY=""

# Hugging Face Inference API (Free tier user access token)
# Tier 1: Hosted small OCR model (defaults to microsoft/trocr-base-handwritten)
# Tier 2: In-process Tesseract.js WASM engine engages automatically on token absence/failure
HF_API_TOKEN=""
HF_OCR_MODEL="microsoft/trocr-base-handwritten"

# Payment Gateway (Razorpay or Cashfree Sandbox / Test Mode)
# If omitted, application falls back to NPCI spec simulated UPI sandbox modal
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# SMS Provider for Real OTP Delivery (Optional free-tier provider, e.g. Twilio/MSG91)
# If omitted or delivery fails, on-screen demo SMS banner displays OTP safely for reviewer testing
SMS_PROVIDER_API_KEY=""

# Cron secret for automated refill reminder job
CRON_SECRET=""

# Mock settings (true for local dev / demo mode)
OTP_MOCK="true"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
